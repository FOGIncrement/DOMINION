generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  // MVP dev datastore: SQLite, file-based, zero local setup.
  // Swapping to Postgres later is a provider + DATABASE_URL change only —
  // no String-typed "enum" fields below rely on SQLite-only behavior.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Player {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  createdAt        DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  lastSeenSnapshot String? // JSON-serialized {food,wood,stone,gold,population} baseline for offline-progression diffing

  settlement Settlement?
  companies  Company[]
  shareholdings Shareholding[]
  banks      Bank[]
  deposits   Deposit[]
  bondsHeld  Bond[]
  corporateBondsHeld CorporateBond[]
  government Government?
}

model Government {
  id                              String   @id @default(cuid())
  playerId                        String   @unique
  player                          Player   @relation(fields: [playerId], references: [id])
  treasury                        Float    @default(0)
  incomeTaxRate                   Float    @default(0)
  corporateTaxRate                Float    @default(0)
  welfareRatePerUnemployedPerHour Float    @default(0.5)
  createdAt                       DateTime @default(now())

  bondsIssued Bond[]
}

// Government debt, distinct from a bank Deposit: the borrower is a
// government's treasury (not a bank's lending pool), and the term is a real
// maturity — full principal + accrued interest redeemed automatically once,
// not a withdraw-anytime balance. Redemption is capped by the issuing
// government's treasury at maturity, the same "can't pay out more than it
// actually has" idiom a deposit withdrawal already gets from bank liquidity.
model Bond {
  id                  String    @id @default(cuid())
  governmentId        String
  government          Government @relation(fields: [governmentId], references: [id])
  holderId            String
  holder              Player    @relation(fields: [holderId], references: [id])
  principal           Float
  interestRatePerHour Float
  termHours           Int
  issuedAt            DateTime  @default(now())
  maturesAt           DateTime
  redeemedAt          DateTime?

  @@index([governmentId])
  @@index([holderId])
}

model Settlement {
  id          String   @id @default(cuid())
  playerId    String?  @unique
  player      Player?  @relation(fields: [playerId], references: [id])
  name        String
  archetype   String? // null for the player settlement; "agrarian" | "mining" | "trade" for NPCs
  era         Int      @default(1)
  food        Float
  wood        Float
  stone       Float
  gold        Float
  storageCap  Float
  lastTickAt  DateTime @default(now())
  foundedAt   DateTime @default(now())

  population Population?
  buildings  Building[]
  techs      SettlementTech[]
  events     Event[]
  trades     MarketTrade[]
}

model Population {
  settlementId String     @id
  settlement   Settlement @relation(fields: [settlementId], references: [id])
  count        Float
  growthRate   Float      @default(0.01)
  happiness    Float      @default(0.7)
}

model Building {
  id               String     @id @default(cuid())
  settlementId     String
  settlement       Settlement @relation(fields: [settlementId], references: [id])
  type             String
  level            Int        @default(1)
  workersAssigned  Int        @default(0)
  builtAt          DateTime   @default(now())

  @@index([settlementId])
}

model SettlementTech {
  id           String     @id @default(cuid())
  settlementId String
  settlement   Settlement @relation(fields: [settlementId], references: [id])
  techId       String
  researchedAt DateTime   @default(now())

  @@unique([settlementId, techId])
}

model MarketResource {
  resourceType String   @id
  supply       Float
  demand       Float
  price        Float
  updatedAt    DateTime @default(now())
}

model PriceHistoryPoint {
  id           String   @id @default(cuid())
  resourceType String
  price        Float
  recordedAt   DateTime @default(now())

  @@index([resourceType, recordedAt])
}

model MarketTrade {
  id           String      @id @default(cuid())
  settlementId String?
  settlement   Settlement? @relation(fields: [settlementId], references: [id])
  companyId    String?
  company      Company?    @relation(fields: [companyId], references: [id])
  resourceType String
  side         String // "buy" | "sell"
  quantity     Float
  price        Float
  createdAt    DateTime    @default(now())
}

model Company {
  id              String    @id @default(cuid())
  ownerId         String?
  owner           Player?   @relation(fields: [ownerId], references: [id])
  name            String
  industry        String // "bakery" | "sawmill" | "stoneworks"
  cash            Float
  inputStock      Float     @default(0)
  goodsStock      Float     @default(0)
  workersAssigned Int       @default(0)
  level           Int       @default(1)
  totalRevenue    Float     @default(0)
  totalExpenses   Float     @default(0)
  lastTickAt      DateTime  @default(now())
  foundedAt       DateTime  @default(now())

  isPublic        Boolean   @default(false)
  sharesOutstanding Float   @default(0)
  sharePrice      Float     @default(0)
  ipoAt           DateTime?
  closedAt        DateTime?

  trades            MarketTrade[]
  shareholdings     Shareholding[]
  priceHistory      SharePriceHistoryPoint[]
  loans             Loan[]
  bondsIssued       CorporateBond[]
  contractsAsSeller Contract[] @relation("ContractSeller")
  contractsAsBuyer  Contract[] @relation("ContractBuyer")

  @@index([ownerId])
}

// The corporate counterpart to a government Bond: a company borrows directly
// from an investor instead of a bank, at a rate priced by how large the
// issuance is relative to the company's own cash (mirrors computeLoanRate's
// utilization-based risk premium, applied to issuance instead of borrowing).
// Redeemed once in full at maturity, capped by the company's cash the same
// way a government Bond is capped by treasury — except a company can also
// close before maturity, unlike a government, so an outstanding bond gets
// force-redeemed (pro-rata against whatever cash remains, if several bonds
// are outstanding) at closure time too, ahead of any cash the founder
// recovers. See redeemCorporateBondsOnClosure in simulation/corporateBonds.ts.
model CorporateBond {
  id                  String    @id @default(cuid())
  companyId           String
  company             Company   @relation(fields: [companyId], references: [id])
  holderId            String
  holder              Player    @relation(fields: [holderId], references: [id])
  principal           Float
  interestRatePerHour Float
  termHours           Int
  issuedAt            DateTime  @default(now())
  maturesAt           DateTime
  redeemedAt          DateTime?

  @@index([companyId])
  @@index([holderId])
}

// A standing supply agreement between two companies — a locked price and
// hourly quantity, settled every tick, instead of either side trading blind
// on the spot market. v2: the proposer must control one of the two
// companies; if the counterparty is an NPC (or the proposer's own other
// company), the contract activates immediately, but if it's another
// player's company it starts as a pending offer (acceptedAt/expiresAt null)
// until that player accepts — expiresAt is computed from acceptance, not
// proposal, so an offer sitting unanswered doesn't eat into its own term.
model Contract {
  id              String    @id @default(cuid())
  sellerCompanyId String
  seller          Company   @relation("ContractSeller", fields: [sellerCompanyId], references: [id])
  buyerCompanyId  String
  buyer           Company   @relation("ContractBuyer", fields: [buyerCompanyId], references: [id])
  resourceType    String
  quantityPerHour Float
  pricePerUnit    Float
  termHours       Int
  createdAt       DateTime  @default(now())
  acceptedAt      DateTime?
  expiresAt       DateTime?
  lastSettledAt   DateTime  @default(now())
  cancelledAt     DateTime?

  @@index([sellerCompanyId])
  @@index([buyerCompanyId])
}

model Bank {
  id                String   @id @default(cuid())
  ownerId           String?
  owner             Player?  @relation(fields: [ownerId], references: [id])
  name              String
  cash              Float
  interestRatePerHour Float
  foundedAt         DateTime @default(now())

  loans    Loan[]
  deposits Deposit[]

  @@index([ownerId])
}

// The opposite side of a Loan: a player parks settlement gold at a bank and
// earns interest at a fraction of the bank's lending rate (DEPOSIT_TUNING),
// the bank's spread. The deposited gold becomes real bank.cash, available to
// lend out — so a withdrawal can be capped by the bank's current liquidity,
// not just the deposit's own balance (a real fractional-reserve consequence,
// not modeled as a special case, just Math.min against bank.cash at withdraw
// time).
model Deposit {
  id                  String   @id @default(cuid())
  bankId              String
  bank                Bank     @relation(fields: [bankId], references: [id])
  playerId            String
  player              Player   @relation(fields: [playerId], references: [id])
  amount              Float
  interestRatePerHour Float
  createdAt           DateTime @default(now())
  lastAccrualAt       DateTime @default(now())

  @@index([bankId])
  @@index([playerId])
}

model Loan {
  id                  String    @id @default(cuid())
  bankId              String
  bank                Bank      @relation(fields: [bankId], references: [id])
  companyId           String
  company             Company   @relation(fields: [companyId], references: [id])
  principal           Float
  outstandingBalance  Float
  interestRatePerHour Float
  termHours           Int?
  maturityAt          DateTime?
  createdAt           DateTime  @default(now())
  lastAccrualAt       DateTime  @default(now())
  defaultedAt         DateTime?

  @@index([bankId])
  @@index([companyId])
}

model NpcInvestor {
  id        String   @id @default(cuid())
  name      String
  archetype String // "conservative" | "growth" | "speculator"
  cash      Float

  shareholdings Shareholding[]
}

model Shareholding {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  playerId      String?
  player        Player?      @relation(fields: [playerId], references: [id])
  npcInvestorId String?
  npcInvestor   NpcInvestor? @relation(fields: [npcInvestorId], references: [id])
  shares        Float

  @@unique([companyId, playerId])
  @@unique([companyId, npcInvestorId])
}

model SharePriceHistoryPoint {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  price      Float
  recordedAt DateTime @default(now())

  @@index([companyId, recordedAt])
}

model Event {
  id           String      @id @default(cuid())
  settlementId String?
  settlement   Settlement? @relation(fields: [settlementId], references: [id])
  type         String
  title        String
  description  String
  occurredAt   DateTime    @default(now())

  @@index([occurredAt])
}

model WorldState {
  id         Int      @id @default(1)
  lastTickAt DateTime @default(now())
}
