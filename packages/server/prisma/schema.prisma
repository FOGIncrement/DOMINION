generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  // MVP dev datastore: SQLite, file-based, zero local setup.
  // Swapping to Postgres later is a provider + DATABASE_URL change only —
  // no String-typed "enum" fields below rely on SQLite-only behavior.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Player {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  createdAt        DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  lastSeenSnapshot String? // JSON-serialized {food,wood,stone,gold,population} baseline for offline-progression diffing
  // Every player that existed before this column was added gets backfilled
  // to "completed" in the migration itself (a raw UPDATE, not left to this
  // default) — the column default only governs brand-new registrations
  // going forward. See routes/tutorial.ts and shared's TUTORIAL_STEPS.
  tutorialStep     String   @default("found_company")
  // Bootstrapped at server boot from ADMIN_EMAIL, not settable via any
  // route — see index.ts. Gates the balance-config panel and (combined
  // with the separate ENABLE_CHEATS env kill-switch) the disposable cheats.
  isAdmin          Boolean  @default(false)

  // Phase 4 (military/conquest): a single scalar, no unit composition — see
  // routes/military.ts. armyStrength always drops to 0 after an attack (win
  // or lose, see the combat design there), so it's a spend-and-recover
  // value, not a stockpile. lastAttackAt gates the attack cooldown the same
  // way territory.ts's computeStatus gates dormant/abandoned off lastSeenAt.
  armyStrength Float    @default(0)
  lastAttackAt DateTime?

  settlement Settlement?
  companies  Company[]
  shareholdings Shareholding[]
  banks      Bank[]
  deposits   Deposit[]
  bondsHeld  Bond[]
  corporateBondsHeld CorporateBond[]
  government Government?
  announcementsPosted Announcement[]
  territories Territory[]
}

model Government {
  id                              String   @id @default(cuid())
  playerId                        String   @unique
  player                          Player   @relation(fields: [playerId], references: [id])
  treasury                        Float    @default(0)
  incomeTaxRate                   Float    @default(0)
  corporateTaxRate                Float    @default(0)
  welfareRatePerUnemployedPerHour Float    @default(0.5)
  createdAt                       DateTime @default(now())

  bondsIssued  Bond[]
  zoneProjects ZoneProject[]
}

// Government debt, distinct from a bank Deposit: the borrower is a
// government's treasury (not a bank's lending pool), and the term is a real
// maturity — full principal + accrued interest redeemed automatically once,
// not a withdraw-anytime balance. Redemption is capped by the issuing
// government's treasury at maturity, the same "can't pay out more than it
// actually has" idiom a deposit withdrawal already gets from bank liquidity.
model Bond {
  id                  String    @id @default(cuid())
  governmentId        String
  government          Government @relation(fields: [governmentId], references: [id])
  holderId            String
  holder              Player    @relation(fields: [holderId], references: [id])
  principal           Float
  interestRatePerHour Float
  termHours           Int
  issuedAt            DateTime  @default(now())
  maturesAt           DateTime
  redeemedAt          DateTime?

  @@index([governmentId])
  @@index([holderId])
}

model Settlement {
  id          String   @id @default(cuid())
  playerId    String?  @unique
  player      Player?  @relation(fields: [playerId], references: [id])
  name        String
  archetype   String? // null for the player settlement; "agrarian" | "mining" | "trade" for NPCs
  era         Int      @default(1)
  food        Float
  wood        Float
  stone       Float
  gold        Float
  storageCap  Float
  lastTickAt  DateTime @default(now())
  foundedAt   DateTime @default(now())

  // This settlement's slot on the shared world-plot grid (see
  // WORLD_PLOT_COLS/ROWS in gameConfig.ts) — assigned once at creation by
  // settlementFactory.ts's assignSettlementPlot. Nullable rather than
  // defaulted: a rebuild-table SQLite migration would apply any hardcoded
  // default to every pre-existing row identically, colliding every
  // existing settlement onto the same plot. Pre-existing rows are
  // backfilled once, deterministically, by a one-off script instead — see
  // the add_world_plots migration.
  worldCol    Int?
  worldRow    Int?

  population   Population?
  buildings    Building[]
  techs        SettlementTech[]
  events       Event[]
  trades       MarketTrade[]
  zones        SettlementZone[]
  zoneProjects ZoneProject[]
}

model Population {
  settlementId String     @id
  settlement   Settlement @relation(fields: [settlementId], references: [id])
  count        Float
  growthRate   Float      @default(0.01)
  happiness    Float      @default(0.7)
}

model Building {
  id               String     @id @default(cuid())
  settlementId     String
  settlement       Settlement @relation(fields: [settlementId], references: [id])
  type             String
  level            Int        @default(1)
  workersAssigned  Int        @default(0)
  builtAt          DateTime   @default(now())

  @@index([settlementId])
}

model SettlementTech {
  id           String     @id @default(cuid())
  settlementId String
  settlement   Settlement @relation(fields: [settlementId], references: [id])
  techId       String
  researchedAt DateTime   @default(now())

  @@unique([settlementId, techId])
}

// Like SettlementTech, but repeatable — a settlement can commission the
// same zone type multiple times to keep scaling founding capacity, so
// there's deliberately no unique([settlementId, type]) constraint here.
model SettlementZone {
  id           String     @id @default(cuid())
  settlementId String
  settlement   Settlement @relation(fields: [settlementId], references: [id])
  type         String
  slotsGranted Int
  completedAt  DateTime   @default(now())

  // Local zoning-grid rectangle (see PLOT_ZONING_SIZE) this zone occupies
  // within its settlement's own plot, copied over from the originating
  // ZoneProject at completion time. Nullable — zones completed before this
  // column existed have no placement and simply don't render spatially.
  zoneX        Int?
  zoneY        Int?
  zoneWidth    Int?
  zoneHeight   Int?

  @@index([settlementId])
}

// A government's commission of a construction company to build a zone —
// one-time delivery (funds move once, at accept), not a recurring resource
// flow like Contract. Purely treasury-funded — construction is a
// contractOnly industry with no goods stockpile to consume. settlementId is
// stored directly rather than derived through government.playerId ->
// Settlement.playerId, same "store the concrete party" idiom Contract
// already uses for seller/buyer.
model ZoneProject {
  id                     String     @id @default(cuid())
  governmentId           String
  government             Government @relation(fields: [governmentId], references: [id])
  constructionCompanyId  String
  constructionCompany    Company    @relation(fields: [constructionCompanyId], references: [id])
  settlementId           String
  settlement             Settlement @relation(fields: [settlementId], references: [id])
  zoneType               String
  treasuryCost           Float
  buildTimeHours         Int
  createdAt              DateTime   @default(now())
  acceptedAt             DateTime?
  completesAt            DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?

  // Local zoning-grid rectangle within the settlement's own plot (see
  // PLOT_ZONING_SIZE) — required for every new commission, but nullable at
  // the schema level so pre-existing rows from before this column existed
  // don't need an invented placement (same reasoning as SettlementZone's
  // matching fields, and Settlement.worldCol/worldRow above).
  zoneX                  Int?
  zoneY                  Int?
  zoneWidth              Int?
  zoneHeight             Int?

  @@index([governmentId])
  @@index([constructionCompanyId])
  @@index([settlementId])
}

model MarketResource {
  resourceType String   @id
  supply       Float
  demand       Float
  price        Float
  updatedAt    DateTime @default(now())
}

model PriceHistoryPoint {
  id           String   @id @default(cuid())
  resourceType String
  price        Float
  recordedAt   DateTime @default(now())

  @@index([resourceType, recordedAt])
}

model MarketTrade {
  id           String      @id @default(cuid())
  settlementId String?
  settlement   Settlement? @relation(fields: [settlementId], references: [id])
  companyId    String?
  company      Company?    @relation(fields: [companyId], references: [id])
  resourceType String
  side         String // "buy" | "sell"
  quantity     Float
  price        Float
  createdAt    DateTime    @default(now())
}

model Company {
  id              String    @id @default(cuid())
  ownerId         String?
  owner           Player?   @relation(fields: [ownerId], references: [id])
  name            String
  industry        String // "bakery" | "sawmill" | "stoneworks"
  cash            Float
  inputStock      Float     @default(0)
  goodsStock      Float     @default(0)
  workersAssigned Int       @default(0)
  // Opt-in "organic hiring" — when true, idle settlement population fills
  // this company's open worker slots automatically every tick, same as an
  // NPC settlement's buildings (see maybeAssignIdleWorkers). Off by default
  // for every company, existing and new alike, since it hands the company
  // over to automatic management rather than the player's own +/-/Max
  // controls; see the organic-hiring step in simulation/engine.ts.
  autoStaff       Boolean   @default(false)
  level           Int       @default(1)
  // How many physical sites this company runs, sharing one cash/branding/P&L
  // pool — orthogonal to `level` (which raises per-worker efficiency
  // company-wide). Multiplies the worker cap; see computeCompanyMaxWorkers.
  facilityCount   Int       @default(1)
  totalRevenue    Float     @default(0)
  totalExpenses   Float     @default(0)
  lastTickAt      DateTime  @default(now())
  foundedAt       DateTime  @default(now())

  isPublic        Boolean   @default(false)
  sharesOutstanding Float   @default(0)
  sharePrice      Float     @default(0)
  ipoAt           DateTime?
  closedAt        DateTime?

  // Set only for an extraction company founded via the territory-gated path
  // (routes/territory.ts's found-extraction, not the zoning-gated
  // routes/companies.ts path) — which specific territory's deposits it
  // draws from. Not unique: a territory can host up to one extraction
  // company per resource it actually has. No FK to Territory (baked seed
  // data, not a DB row) — read live via worldgen/loadedTerritoryData.ts's
  // getSeedByIndex wherever this matters, so it can never drift out of sync.
  territorySeedIndex Int?

  trades            MarketTrade[]
  shareholdings     Shareholding[]
  priceHistory      SharePriceHistoryPoint[]
  loans             Loan[]
  bondsIssued       CorporateBond[]
  contractsAsSeller Contract[] @relation("ContractSeller")
  contractsAsBuyer  Contract[] @relation("ContractBuyer")
  zoneProjects      ZoneProject[]

  @@index([ownerId])
}

// The corporate counterpart to a government Bond: a company borrows directly
// from an investor instead of a bank, at a rate priced by how large the
// issuance is relative to the company's own cash (mirrors computeLoanRate's
// utilization-based risk premium, applied to issuance instead of borrowing).
// Redeemed once in full at maturity, capped by the company's cash the same
// way a government Bond is capped by treasury — except a company can also
// close before maturity, unlike a government, so an outstanding bond gets
// force-redeemed (pro-rata against whatever cash remains, if several bonds
// are outstanding) at closure time too, ahead of any cash the founder
// recovers. See redeemCorporateBondsOnClosure in simulation/corporateBonds.ts.
model CorporateBond {
  id                  String    @id @default(cuid())
  companyId           String
  company             Company   @relation(fields: [companyId], references: [id])
  holderId            String
  holder              Player    @relation(fields: [holderId], references: [id])
  principal           Float
  interestRatePerHour Float
  termHours           Int
  issuedAt            DateTime  @default(now())
  maturesAt           DateTime
  redeemedAt          DateTime?

  @@index([companyId])
  @@index([holderId])
}

// A standing supply agreement between two companies — a locked price and
// hourly quantity, settled every tick, instead of either side trading blind
// on the spot market. v2: the proposer must control one of the two
// companies; if the counterparty is an NPC (or the proposer's own other
// company), the contract activates immediately, but if it's another
// player's company it starts as a pending offer (acceptedAt/expiresAt null)
// until that player accepts — expiresAt is computed from acceptance, not
// proposal, so an offer sitting unanswered doesn't eat into its own term.
model Contract {
  id              String    @id @default(cuid())
  sellerCompanyId String
  seller          Company   @relation("ContractSeller", fields: [sellerCompanyId], references: [id])
  buyerCompanyId  String
  buyer           Company   @relation("ContractBuyer", fields: [buyerCompanyId], references: [id])
  resourceType    String
  quantityPerHour Float
  pricePerUnit    Float
  termHours       Int
  createdAt       DateTime  @default(now())
  acceptedAt      DateTime?
  expiresAt       DateTime?
  lastSettledAt   DateTime  @default(now())
  cancelledAt     DateTime?

  @@index([sellerCompanyId])
  @@index([buyerCompanyId])
}

model Bank {
  id                String   @id @default(cuid())
  ownerId           String?
  owner             Player?  @relation(fields: [ownerId], references: [id])
  name              String
  cash              Float
  interestRatePerHour Float
  foundedAt         DateTime @default(now())

  loans    Loan[]
  deposits Deposit[]

  @@index([ownerId])
}

// The opposite side of a Loan: a player parks settlement gold at a bank and
// earns interest at a fraction of the bank's lending rate (DEPOSIT_TUNING),
// the bank's spread. The deposited gold becomes real bank.cash, available to
// lend out — so a withdrawal can be capped by the bank's current liquidity,
// not just the deposit's own balance (a real fractional-reserve consequence,
// not modeled as a special case, just Math.min against bank.cash at withdraw
// time).
model Deposit {
  id                  String   @id @default(cuid())
  bankId              String
  bank                Bank     @relation(fields: [bankId], references: [id])
  playerId            String
  player              Player   @relation(fields: [playerId], references: [id])
  amount              Float
  interestRatePerHour Float
  createdAt           DateTime @default(now())
  lastAccrualAt       DateTime @default(now())

  @@index([bankId])
  @@index([playerId])
}

model Loan {
  id                  String    @id @default(cuid())
  bankId              String
  bank                Bank      @relation(fields: [bankId], references: [id])
  companyId           String
  company             Company   @relation(fields: [companyId], references: [id])
  principal           Float
  outstandingBalance  Float
  interestRatePerHour Float
  termHours           Int?
  maturityAt          DateTime?
  createdAt           DateTime  @default(now())
  lastAccrualAt       DateTime  @default(now())
  defaultedAt         DateTime?

  @@index([bankId])
  @@index([companyId])
}

model NpcInvestor {
  id        String   @id @default(cuid())
  name      String
  archetype String // "conservative" | "growth" | "speculator"
  cash      Float

  shareholdings Shareholding[]
}

model Shareholding {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  playerId      String?
  player        Player?      @relation(fields: [playerId], references: [id])
  npcInvestorId String?
  npcInvestor   NpcInvestor? @relation(fields: [npcInvestorId], references: [id])
  shares        Float

  @@unique([companyId, playerId])
  @@unique([companyId, npcInvestorId])
}

model SharePriceHistoryPoint {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  price      Float
  recordedAt DateTime @default(now())

  @@index([companyId, recordedAt])
}

model Event {
  id           String      @id @default(cuid())
  settlementId String?
  settlement   Settlement? @relation(fields: [settlementId], references: [id])
  type         String
  title        String
  description  String
  occurredAt   DateTime    @default(now())

  @@index([occurredAt])
}

model WorldState {
  id         Int      @id @default(1)
  lastTickAt DateTime @default(now())
}

// Launcher/site news — deliberately separate from Event (in-game simulation
// events like harvests and storms): this is dev-authored, admin-posted
// content shown in the desktop launcher's Hub screen, not something the
// tick engine ever writes.
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  authorId  String
  author    Player   @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Singleton row, same shape idiom as WorldState. `data` holds only the
// DELTA an admin has actually changed (a JSON-serialized deep-partial of
// the tuning-group shape in gameConfigStore.ts), not a full frozen copy of
// every default — so a future change to a gameConfig.ts default isn't
// silently overridden by an old, unrelated edit. Hand-rolled JSON string
// (not Prisma's Json type) matches the existing Player.lastSeenSnapshot
// idiom already in this schema.
model GameConfigOverride {
  id        Int      @id @default(1)
  data      String   @default("{}")
  updatedAt DateTime @updatedAt
}

// Margin land-system Phase 2. seedIndex identifies one territory from the
// baked, never-changing partition in worldgen-output/seeds.json +
// territoryOwner.u16 (see worldgen/generateTerritories.ts) — the geometry
// itself (which cells belong to this seed, its area/center/biome/resource
// summary) is never stored here, only ownership. A row only ever exists
// once a seed has actually been claimed; an unclaimed seed simply has no
// row at all (no "unclaimed" status value needed).
//
// Deliberately NO stored status column (active/dormant/abandoned) — that's
// computed at read time from the owning Player.lastSeenAt against
// TERRITORY_TUNING's day thresholds (see routes/territory.ts), which also
// makes "reclaim" automatic: a returning player's lastSeenAt already
// refreshes via the existing offline-summary mechanism the moment they play
// again, with zero extra code here.
model Territory {
  id        String   @id @default(cuid())
  seedIndex Int      @unique
  ownerId   String
  owner     Player   @relation(fields: [ownerId], references: [id])
  claimedAt DateTime @default(now())

  @@index([ownerId])
}
